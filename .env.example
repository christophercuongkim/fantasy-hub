# Web → API (internal Docker network service name in prod; localhost in dev)
API_URL=http://api:4001

# Parquet cold tier root (api)
PARQUET_ROOT=/data

# Postgres (Neon) — web + api both read/write it
DATABASE_URL=postgresql://...neon.tech/...?sslmode=require

# Public base URL of the web app (drives the Yahoo OAuth redirect_uri)
APP_BASE_URL=http://localhost:4000

# Yahoo OAuth (web does the handshake; api refreshes + calls the Fantasy API)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# AES-256-GCM key for token encryption at rest — base64 of 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST be identical on web and api.
TOKEN_ENC_KEY=
